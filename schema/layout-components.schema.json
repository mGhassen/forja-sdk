      "aliases": ["tabs"],
      "props": ["tabs", "items", "default"]
    },
    {
      "type": "kit.list",
      "foundation": "CatalogCardsGrid",
      "tier": "layout",
      "status": "mounted",
      "helper": "kitList",
      "props": ["items", "style", "kindMenu", "statusTab", "source", "load", "gap", "pad", "cardKind", "emptyTitle", "emptyDescription", "open", "openSetting"]
    },
    {
      "type": "kit.row",
      "foundation": "PosterRail",
      "tier": "layout",
      "status": "mounted",
      "helper": "kitRow",
      "aliases": ["rail", "ranked"],
      "props": ["title", "items", "style", "load", "aspect", "gap", "rankedGap", "pad", "titlePad", "hideWhenBleed", "focusUp", "focusDown"]
