{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forja.app/sdk/schema/layout-components.schema.json",
  "title": "Forja foundation components catalog",
  "description": "Full forja_foundation inventory for pack authors. status=mounted → PackPaintTree accepts type today. status=not_mounted → exists in DS, not pack-JSON yet. See docs/components.md.",
  "version": 2,
  "statusValues": ["mounted", "not_mounted"],
  "components": [
    {
      "type": "kit.stack",
      "foundation": "LayoutStack",
      "tier": "layout",
      "status": "mounted",
      "helper": "kitStack",
      "aliases": ["stack"],
      "props": ["children", "widgets", "expand", "expandLast", "axis"]
    },
    {
      "type": "kit.topBar",
      "foundation": "CatalogTopChrome",
      "tier": "layout",
      "status": "mounted",
      "helper": "kitTopBar",
      "aliases": ["topBar", "kit.top_bar"],
      "props": ["actions", "title", "label"]
    },
    {
      "type": "kit.categoryBar",
      "foundation": "CatalogChipBar / CatalogSideRail",
      "tier": "layout",
      "status": "mounted",
      "helper": "kitCategoryBar",
      "aliases": ["categoryBar", "kit.category_bar", "kinds"],
      "props": ["items", "default", "orientation", "axis", "vertical", "width"]
    },
    {
      "type": "kit.menu",
      "foundation": "ForjaShellChip / CatalogChipBar",
